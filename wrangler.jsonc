{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,

  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "3e613e27742c4ccb97817f6e660f2f3a",
      "id": "3e613e27742c4ccb97817f6e660f2f3a"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
